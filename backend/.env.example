# ───────────────────────────────────────────────
# CenAGRI-AI backend — Environment Variable Template
# Copy to backend/.env and fill in real values. Never commit .env.
# (The repo-root .env is only used when backend/.env is missing.)
# ───────────────────────────────────────────────

# App
APP_NAME=CenAGRI-AI
APP_ENV=development
APP_PORT=8000
APP_DEBUG=true

# CORS (comma separated origins)
# Production on Render: your Netlify origin, no trailing slash, e.g.
#   CORS_ORIGINS=https://your-site.netlify.app
# A mismatch here is the most common cause of "blocked by CORS policy" in the
# deployed app — the browser refuses every API call.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database (PostgreSQL / Supabase → Project Settings → Database → Session pooler)
DATABASE_URL=postgresql+psycopg://postgres:change_me@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# AI / LLM providers
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Live mandi prices — data.gov.in API key (server-side only, never VITE_*)
DATA_GOV_API_KEY=
DATA_GOV_BASE_URL=https://api.data.gov.in

# ── Central admin panel ────────────────────────────────────────────────────
# Without these three the /api/v1/admin router is NOT mounted (fails closed).
# Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Token verification: modern projects publish JWKS derived from SUPABASE_URL —
# leave SUPABASE_JWT_SECRET empty for them. Legacy HS256 projects:
# Project Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
ADMIN_SESSION_MAX_MINUTES=480
ADMIN_MFA_REQUIRED=false
ADMIN_RATE_LIMIT_PER_MINUTE=240
