# ───────────────────────────────────────────────
# CenAGRI-AI — Environment Variable Template
# Copy to .env and fill in real values. Never commit .env.
# ───────────────────────────────────────────────

# App
APP_NAME=CenAGRI-AI
APP_ENV=development
APP_PORT=8000
APP_DEBUG=true

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_SITE_URL=http://localhost:5173

# Supabase (auth + database) — Project Settings → API
# The anon key is public by design; never put the service_role key here.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Database (PostgreSQL)
POSTGRES_USER=cenagri
POSTGRES_PASSWORD=change_me
POSTGRES_DB=cenagri
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://cenagri:change_me@localhost:5432/cenagri

# Auth
JWT_SECRET=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI / LLM providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=

# CORS (comma separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
