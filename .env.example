# ───────────────────────────────────────────────
# CenAGRI-AI — Environment Variable Template
# Copy to .env and fill in real values. Never commit .env.
# ───────────────────────────────────────────────

# App
APP_NAME=CenAGRI-AI
APP_ENV=development
APP_PORT=8000
APP_DEBUG=true

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_SITE_URL=http://localhost:5173

# Supabase (auth + database) — Project Settings → API
# The anon key is public by design; never put the service_role key here.qebcxpgwunhjoskddiq.supabase.co
VITE_SUPABASE_ANON_KEY=

# Database (PostgreSQL)
POSTGRES_USER=cenagri
POSTGRES_PASSWORD=change_me
POSTGRES_DB=cenagri
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://cenagri:change_me@localhost:5432/cenagri

# Auth
JWT_SECRET=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI / LLM providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=

# Multilingual AI chat. The Multi Model AI Assistant owns language detection,
# agriculture retrieval and answer generation; CenAGRI forwards questions to it.
# Leave AI_ASSISTANT_URL empty to disable /api/v1/ai/chat cleanly.
AI_ASSISTANT_URL=
AI_ASSISTANT_KEY=

# On-demand translation of user-generated content (posts, product descriptions).
# Empty TRANSLATE_PROVIDER = translation stays off and reports ok=false.
# Server-side only — never expose this key as a VITE_* variable.
TRANSLATE_PROVIDER=
TRANSLATE_API_KEY=
TRANSLATE_TIMEOUT_SECONDS=12

# Live mandi prices — data.gov.in API key (server-side only, never VITE_*)
# Dataset: "Current Daily Price of Various Commodities from Various Markets (Mandi)"
# https://data.gov.in → your account → API key
DATA_GOV_API_KEY=
DATA_GOV_BASE_URL=https://api.data.gov.in

# CORS (comma separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
