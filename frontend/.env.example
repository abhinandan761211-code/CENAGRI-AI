# ───────────────────────────────────────────────
# Frontend environment (Vite). Copy to frontend/.env
# Only VITE_* vars are exposed to the browser — never put service keys here.
# ───────────────────────────────────────────────

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Backend API root.
#
# LEAVE THIS EMPTY unless the API is on a different origin than the site.
# Empty (or a relative "/api/v1") means "same origin", which is what you want on
# Vercel and Netlify: their /api/* rewrite/proxy forwards to Render.
#
# A localhost URL here is inlined into the JavaScript at build time, so a
# production build that contains it calls the VISITOR's machine and every
# request fails (this is what makes the admin panel say "unreachable"). The
# client ignores loopback URLs in a production build, but do not rely on that.
#
# VITE_API_BASE_URL=

# Public URL used for OAuth + email redirects.
# Local: http://localhost:5173   Production: https://<your-site>.vercel.app (no trailing slash)
VITE_SITE_URL=http://localhost:5173

# Weather (OpenWeatherMap) — public client key, restrict it by domain
VITE_OPENWEATHER_KEY=YOUR_OPENWEATHERMAP_KEY
