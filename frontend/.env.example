# ───────────────────────────────────────────────
# Frontend environment (Vite). Copy to frontend/.env
# Only VITE_* vars are exposed to the browser — never put service keys here.
# ───────────────────────────────────────────────

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Backend API (leave empty to use the dev proxy / same-origin /api/v1)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Public URL used for OAuth + email redirects.
# Local: http://localhost:5173   Production: https://cenagri.ai (no trailing slash)
VITE_SITE_URL=http://localhost:5173
